# Dependencias y builds
node_modules/
dist/
dist-*/
out/
release/
coverage/
test-results/
playwright-report/
*.tsbuildinfo
jas-wave/build/
**/build/electron/

# Declaraciones generadas por tsc -b (tsconfig.node.json)
jas-wave/vite.config.d.ts
jas-wave/electron/*.d.ts

# Env / secretos
.env
.env.*
!.env.example

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Archivos y logs locales
*.zip
*.tgz
*.tar.gz
*.log
npm-debug.log*

# Binarios nativos (los genera CI / scripts de build)
jas-wave/resources/plugin-host/jaswave-plugin-host.exe
jas-wave/resources/plugin-host/jaswave-plugin-host.pdb
jas-wave/resources/vst3/
native/plugin-host/build*/
native/plugin-host/third_party/
native/audio-engine/build/

# CLI: scripts/probes temporales con prefijo "_" (los versionados siguen trackeados)
jas-wave/cli/_*
jas-wave/jas-wave/

# Worktrees/estado local de agentes
.claude/
native/plugin-host/build-release/

# Artefactos de build de plugins y CMake (binarios generados, no fuente)
plugins/build*/
plugins/*/build*/
plugins/*/bin/
plugins/*/v*/
plugins/tests/build/
plugins/**/*.vst3
plugins/**/*.vst3/

# Salidas de compilación de cualquier proyecto nativo (incluye restos de plugins movidos a plugins/)
native/*/build*/
