{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES6",
    "types": ["node"],
    "outDir": "build/electron"
  },
  "include": ["electron/**/*"]
}
