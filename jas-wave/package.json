{
  "name": "jaswave",
  "version": "0.1.0",
  "private": true,
  "productName": "JasWave",
  "author": "JasWave",
  "description": "JasWave — AI-First Digital Audio Workstation",
  "main": "build/electron/electron/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.electron.json && tsx scripts/free-vite-port.ts && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 concurrently -k \"vite --strictPort --port 5173\" \"wait-on http://localhost:5173 && tsx scripts/start-electron.ts .\"",
    "web:dev": "vite",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('build',{recursive:true,force:true});for(const f of fs.readdirSync('.'))if(f.endsWith('.tsbuildinfo'))fs.rmSync(f)\"",
    "build": "npm run clean && tsc -b && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p e2e/tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\" \"lib/**/*.test.ts\" \"electron/**/*.test.ts\"",
    "test:plugins": "npm test",
    "lint": "eslint .",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:dev": "cross-env JASWAVE_E2E_TARGET=dev playwright test -c e2e/playwright.config.ts",
    "pack:dir": "npm run build && npm run stage:host && electron-builder --win dir",
    "preview": "vite preview",
    "stage:host": "node scripts/stage-plugin-host.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "electron:build": "npm run build && npm run stage:host && electron-builder --win nsis --publish never",
    "pack:win": "npm run electron:build",
    "plugin-host:ping": "node ../native/plugin-host/scripts/ping.cjs",
    "cli": "node cli/daw-cli.mjs",
    "cli:watch": "node cli/daw-cli.mjs watch --play",
    "cli:audit": "node cli/daw-cli.mjs audit",
    "cli:certify": "node cli/_certify.mjs",
    "cli:certify:quick": "node cli/_certify.mjs --quick",
    "cli:certify:vst": "node cli/_e2e-decent-4front.mjs 14 && node cli/_test-three-vst.mjs",
    "cli:soak-host": "node cli/_soak-host.mjs",
    "cli:soak-host:30": "cross-env SOAK_MINUTES=30 node cli/_soak-host.mjs",
    "cli:soak-host:4h": "cross-env SOAK_MINUTES=240 node cli/_soak-host.mjs",
    "native:plugins": "node ../native/scripts/build-plugins.mjs",
    "stage:host:strict": "node scripts/stage-plugin-host.mjs --strict",
    "electron:dir": "npm run build && npm run stage:host && electron-builder --win dir --publish never",
    "release:win": "npm run build && npm run stage:host:strict && electron-builder --win nsis --publish always",
    "build:web": "vite build --mode web --outDir dist-web",
    "web:preview": "vite preview --outDir dist-web --port 4173",
    "sdk:generar": "node scripts/generar-sdk.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.10"
  },
  "devDependencies": {
    "@base-ui/react": "^1.5.0",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@jaswave/ai-harness": "file:../ai-harness",
    "@jaswave/shared": "file:../shared",
    "@playwright/test": "1.63.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "lucide-react": "^1.16.0",
    "mermaid": "^11.17.2",
    "postcss": "^8.5",
    "react": "^19",
    "react-dom": "^19",
    "react-resizable-panels": "^2.1.9",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "katex": "^0.19.0"
  }
}
