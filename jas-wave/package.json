{
  "name": "jaswave",
  "version": "0.1.0",
  "private": true,
  "productName": "JasWave",
  "main": "build/electron/electron/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.electron.json && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 concurrently \"vite\" \"wait-on http://localhost:5173 && tsx scripts/start-electron.ts .\"",
    "web:dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder",
    "lint": "eslint .",
    "test:plugins": "tsx --test src/lib/plugin/hybrid-host.test.ts src/lib/plugin/audio-engine-robust.test.ts src/lib/midi-agent.test.ts src/lib/plugin-knowledge.test.ts",
    "plugin-host:ping": "node ../native/plugin-host/scripts/ping.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19",
    "react-dom": "^19",
    "react-resizable-panels": "^2.1.9",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.7.3",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.jaswave.app",
    "productName": "JasWave",
    "directories": {
      "output": "release"
    },
    "icon": "public/jaswave-icono-con-frecuencia.png",
    "files": [
      "dist/**/*",
      "build/electron/**/*",
      "resources/plugin-host/**/*",
      "public/jaswave-icono-con-frecuencia.png",
      "public/jaswavelogo.png"
    ],
    "extraResources": [
      {
        "from": "resources/plugin-host",
        "to": "plugin-host"
      },
      {
        "from": "public/jaswave-icono-con-frecuencia.png",
        "to": "jaswave-icono-con-frecuencia.png"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "public/jaswave-icono-con-frecuencia.png"
    },
    "win": {
      "target": "nsis",
      "icon": "public/jaswave-icono-con-frecuencia.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/jaswave-icono-con-frecuencia.png"
    }
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  }
}
