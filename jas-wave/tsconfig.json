{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "@jaswave/ai-harness": ["../ai-harness/src/index.ts"],
      "@jaswave/shared": ["../shared/src/index.ts"],
      "@jaswave/host-sdk/*": ["../plugins/sdk/host-sdk/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/**/*",
    "components/**/*",
    "lib/**/*",
    "hooks/**/*",
    "electron/**/*",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "electron/**", "e2e/**"]
}
