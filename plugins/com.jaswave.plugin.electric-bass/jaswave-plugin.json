{
  "id": "com.jaswave.plugin.electric-bass",
  "name": "JasWave Electric Bass",
  "version": "1.0.0",
  "category": "instrument",
  "vendor": "JasWave Audio",
  "description": "Bajo eléctrico Precision / Jazz por guía de ondas de cuerda (Karplus-Strong extendido, afinación exacta < 1 cent): excitación de dedo o púa/slap según velocidad, pastilla P/J, ghost y palm-mute, legato con hammer-on y pull-off, compresor paralelo, saturación valvular a 2× y realce real de graves con shelving. Rack de mezcla comun integrado (ids FX · 100..230): paso-altos/bajos, ecualizador parametrico de 6 bandas, compresor, saturacion cinta/valvula, chorus, delay sincronizable al tempo, reverb plate/hall/room y anchura. Todo apagado por defecto (On = 0): no cambia el sonido hasta activarlo.",
  "targetPlatforms": [
    "win-x64",
    "web"
  ],
  "entrypoints": {
    "dspDesktop": "bin/JasWaveElectricBass.vst3",
    "dspWeb": "web/electric-bass-worklet.js"
  },
  "vst3": {
    "classId": "{B3A7C9E4-4D2F-4A8B-9E6C-1F3D5A7B8C01}",
    "subCategories": "Instrument|Synth"
  },
  "permissions": {
    "realtimeAudio": true,
    "fileSystem": "none",
    "network": false,
    "commands": [
      "plugin.setParameter"
    ]
  },
  "rolesAllowed": [
    "productor"
  ],
  "license": {
    "productId": "com.jaswave.plugin.electric-bass",
    "features": [
      {
        "key": "bass.tube-drive",
        "description": "Emulación de saturación valvular de previo vintage"
      }
    ]
  },
  "ai": {
    "summary": "Bajo eléctrico P/J con modelado físico de cuerda: tono (tilt), ataque de dedo/púa, saturación valvular, subgrave con shelving, compresión paralela, posición de pastilla y de pulso, sustain, palm-mute, legato y pitch bend ±2 st. Incluye el FX Rack comun (ids 100..230, apagado por defecto): paso-altos/bajos, EQ de 6 bandas, compresor, saturacion, chorus, delay con sync, reverb y anchura; todo configurable con plugin.setParameter.",
    "intents": [
      "bajo-electrico",
      "linea-de-bajo",
      "groove-solido",
      "sub-bajo",
      "bajo-worship",
      "ghost-notes",
      "palm-mute",
      "legato-slide"
