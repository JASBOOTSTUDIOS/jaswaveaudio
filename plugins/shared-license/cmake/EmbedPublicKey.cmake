# Genera un header C++ con la clave pública Ed25519 (32 bytes) extraída de un PEM SPKI.
#   cmake -DPEM=<ruta.pem> -DOUT=<header.h> -P EmbedPublicKey.cmake
# Falla si el PEM no es una clave pública Ed25519 (prefijo DER 302a300506032b6570032100).

if(NOT PEM OR NOT OUT)
  message(FATAL_ERROR "EmbedPublicKey: faltan -DPEM y -DOUT")
endif()
file(READ "${PEM}" _pem)
string(REGEX MATCH "-----BEGIN PUBLIC KEY-----(.*)-----END PUBLIC KEY-----" _m "${_pem}")
if(NOT _m)
  message(FATAL_ERROR "EmbedPublicKey: ${PEM} no contiene un bloque PUBLIC KEY")
endif()
string(REGEX REPLACE "[\r\n\t ]" "" _b64 "${CMAKE_MATCH_1}")
string(REGEX REPLACE "=+$" "" _b64 "${_b64}")

set(_alphabet "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
string(LENGTH "${_b64}" _len)
set(_acc 0)
set(_bits 0)
set(_hex "")
math(EXPR _last "${_len} - 1")
foreach(_i RANGE 0 ${_last})
  string(SUBSTRING "${_b64}" ${_i} 1 _c)
  string(FIND "${_alphabet}" "${_c}" _v)
  if(_v LESS 0)
    message(FATAL_ERROR "EmbedPublicKey: carácter base64 inválido '${_c}'")
  endif()
  math(EXPR _acc "((${_acc} << 6) | ${_v}) & 16777215")
  math(EXPR _bits "${_bits} + 6")
  if(_bits GREATER_EQUAL 8)
    math(EXPR _bits "${_bits} - 8")
    math(EXPR _byte "(${_acc} >> ${_bits}) & 255" OUTPUT_FORMAT HEXADECIMAL)
    string(REPLACE "0x" "" _byte "${_byte}")
    string(LENGTH "${_byte}" _bl)
    if(_bl EQUAL 1)
      set(_byte "0${_byte}")
    endif()
    string(APPEND _hex "${_byte}")
  endif()
endforeach()

string(TOLOWER "${_hex}" _hex)
string(LENGTH "${_hex}" _hexlen)
if(NOT _hexlen EQUAL 88)
  message(FATAL_ERROR "EmbedPublicKey: longitud DER inesperada (${_hexlen} hex), se esperaba SPKI Ed25519 de 44 bytes")
endif()
string(SUBSTRING "${_hex}" 0 24 _prefix)
if(NOT _prefix STREQUAL "302a300506032b6570032100")
  message(FATAL_ERROR "EmbedPublicKey: el PEM no es una clave pública Ed25519 (prefijo ${_prefix})")
endif()
string(SUBSTRING "${_hex}" 24 64 _key)

set(_bytes "")
foreach(_i RANGE 0 62 2)
  string(SUBSTRING "${_key}" ${_i} 2 _b)
  string(APPEND _bytes "0x${_b},")
endforeach()

set(_content "// Generado por plugins/shared-license/cmake/EmbedPublicKey.cmake desde licencia_publica.pem. No editar.\n#pragma once\n#include <cstdint>\nnamespace JasWaveLicense {\nstatic const uint8_t kJwLicensePublicKey[32] = { ${_bytes} };\n}\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
  if(_old STREQUAL _content)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${_content}")
