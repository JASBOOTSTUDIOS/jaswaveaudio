{
  "id": "com.jaswave.plugin.electro-drums",
  "name": "JasWave Electro Drums",
  "version": "1.0.0",
  "category": "instrument",
  "vendor": "JasWave Audio",
  "description": "Caja de ritmos electrónica SINTETIZADA con DSP propio (cero muestras, sin problemas de licencia) para música electrónica, house, techno y pop. Bombo (seno con barrido de tono, click y drive), caja (cuerpo tonal + ruido filtrado), clap (ráfagas de ruido), rimshot, hi-hats de 6 osciladores cuadrados PolyBLEP con choke cerrado/pedal/abierto, 6 toms afinables, crash/ride/china/splash metálicos, cowbell, shaker, cabasa y pandereta. Kits 808, 909, Techno duro y Lo-fi. Respuesta a la velocidad en volumen y timbre. Mapa General MIDI de batería. Salida estéreo con nivel y panorama por voz y limitador suave. Rack de mezcla común integrado (ids FX · 100..230), apagado por defecto.",
  "targetPlatforms": [
    "win-x64"
  ],
  "entrypoints": {
    "dspDesktop": "bin/JasWaveElectroDrums.vst3"
  },
  "vst3": {
    "classId": "{E1EC7A0D-4D2F-4A8B-9E6C-1F3D5A7B8C01}",
    "subCategories": "Instrument|Drum"
  },
  "permissions": {
    "realtimeAudio": true,
    "fileSystem": "none",
    "network": false,
    "commands": [
      "plugin.setParameter"
    ]
  },
  "rolesAllowed": [
    "productor"
  ],
  "license": {
    "productId": "com.jaswave.plugin.electro-drums",
    "features": [
      {
        "key": "drums.electro-kits",
        "description": "Kits Techno duro y Lo-fi"
      }
    ]
  },
  "ai": {
    "summary": "Caja de ritmos electrónica sintetizada (sin muestras) para house, techno, pop y electrónica: bombo con barrido de tono, caja, clap, rimshot, hi-hats con choke, toms, platos, cowbell, shaker y pandereta. Cuatro kits (808, 909, Techno duro, Lo-fi), afinación, decay, drive, nivel y panorama por voz. La velocidad cambia volumen y timbre. Mapa de notas GM (sin transponer; las demás notas no suenan): 36/35 bombo, 38 caja, 40 caja eléctrica, 39 clap, 37 rimshot, 42 hat cerrado, 44 hat pedal, 46 hat abierto (cerrado y pedal cortan al abierto), toms 41 43 45 47 48 50 (de grave a agudo), 49/57 crash, 52 china, 55 splash, 51/59 ride, 53 campana de ride, 56 cowbell, 70/82 shaker, 69 cabasa, 54 pandereta. Incluye el FX Rack común (ids 100..230, apagado por defecto).",
    "intents": [
      "bateria-electronica",
      "caja-de-ritmos",
      "house",
      "techno",
      "pop-electronico",
