{
  "id": "com.jaswave.plugin.electric-guitar",
  "name": "JasWave Electric Guitar",
  "version": "1.0.0",
  "category": "instrument",
  "vendor": "JasWave Audio",
  "description": "Guitarra eléctrica de worship moderno: banco de muestras + cadena de efectos + cuerda por guía de ondas de respaldo, con sistema de TÉCNICAS de guitarra controlable por MIDI estándar: slides y glissando (legato por solape, slide-in/out), hammer-on/pull-off, rasgueo con dirección y velocidad por cuerda, palm mute, notas muertas, armónicos, bends/pre-bend, vibrato con retardo, tremolo picking, volume swell (CC11), ruido de dedo/traste/púa; amplificador valvular con sobremuestreo, pantalla 4x12, chorus, delay ping-pong sincronizado y reverb de plato. Rack de mezcla comun integrado (ids FX · 100..230): paso-altos/bajos, ecualizador parametrico de 6 bandas, compresor, saturacion cinta/valvula, chorus, delay sincronizable al tempo, reverb plate/hall/room y anchura. Todo apagado por defecto (On = 0): no cambia el sonido hasta activarlo.",
  "targetPlatforms": [
    "win-x64",
    "web"
  ],
  "entrypoints": {
    "dspDesktop": "bin/JasWaveElectricGuitar.vst3",
    "dspWeb": "web/electric-guitar-worklet.js"
  },
  "vst3": {
    "classId": "{B3A7C9E5-4D2F-4A8B-9E6C-1F3D5A7B8C01}",
    "subCategories": "Instrument|Synth"
  },
  "permissions": {
    "realtimeAudio": true,
    "fileSystem": "none",
    "network": false,
    "commands": [
      "plugin.setParameter"
    ]
  },
  "rolesAllowed": [
    "productor"
  ],
  "license": {
    "productId": "com.jaswave.plugin.electric-guitar",
    "features": [
      {
        "key": "guitar.cab-sim-hd",
        "description": "Emulación de pantalla 4x12 Vintage / Modern con respuesta a impulsos"
      }
    ]
  },
  "ai": {
    "summary": "Guitarra eléctrica de worship con técnicas. MIDI: keyswitches (C4=60) 12 normal/reset, 13 palm mute, 14 nota muerta, 15 armónico natural, 16 artificial, 17 tremolo picking, 18 slide-in, 19/20 slide-out abajo/arriba (solo la siguiente nota), 21 pre-bend, 22 bend-up (siguiente nota), 23 modo legato (solape<=3 st hammer/pull, 4-12 st slide), 24 modo slide (todo solape se desliza), 25/26/27 rasgueo abajo/arriba/alterno, 11 auto-swell. Sin 23/24 las notas solapadas NO se ligan. CC1 vibrato (retardo), CC11 swell de pedal, CC80 articulación (0,25,51,76,102,127), CC81 legato (0 off/64 legato/127 slide), CC82 dirección de rasgueo, CC83 slide in/out; acordes simultáneos = rasgueo. Incluye el FX Rack comun (ids 100..230, apagado por defecto): paso-altos/bajos, EQ de 6 bandas, compresor, saturacion, chorus, delay con sync, reverb y anchura; todo configurable con plugin.setParameter.",
    "intents": [
      "guitarra-electrica",
      "guitarra-worship",
      "arpegio-limpio",
      "riff-crunch",
      "solo-guitarra",
      "melodia-lead",
      "delay-punteado",
      "slide-guitarra",
      "hammer-on",
      "pull-off",
      "rasgueo",
      "palm-mute",
      "armonicos",
      "bend",
