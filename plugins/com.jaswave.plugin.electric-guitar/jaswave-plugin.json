  "tecnicas": {
    "contrato": "Notas MIDI numeradas con C4 = 60. Los keyswitches están por debajo del registro de la guitarra (28+), no suenan y no necesitan note-off.",
    "keyswitchesFijos": {
      "11": "Auto-swell por nota",
      "12": "Normal: reinicia articulación, legato, dirección de rasgueo y auto-swell",
      "13": "Palm mute",
      "14": "Nota muerta / ghost",
      "15": "Armónico natural",
      "16": "Armónico artificial (pinch)",
      "17": "Tremolo picking",
      "23": "Modo legato (solape: <=3 st hammer-on/pull-off, 4-12 st slide)",
      "24": "Modo slide (solape o nota anterior aún sonando: siempre desliza, hasta 12 st)",
      "25": "Rasgueo abajo",
      "26": "Rasgueo arriba",
      "27": "Rasgueo alterno"
    },
    "keyswitchesSiguienteNota": {
      "18": "Slide-in desde abajo",
      "19": "Slide-out hacia abajo al soltar",
      "20": "Slide-out hacia arriba al soltar",
      "21": "Pre-bend (empieza doblada y se relaja)",
      "22": "Bend-up (la nota sube tras el ataque)"
    },
    "cc": {
      "1": "Vibrato (rueda de modulación) con retardo de entrada (param vib_delay)",
      "11": "Expresión: swell de volumen de pedal",
      "64": "Sustain",
      "80": "Articulación: 0 normal, 25 palm mute, 51 muerta, 76 armónico natural, 102 armónico artificial, 127 tremolo picking",
      "81": "Legato/slide: 0-31 off, 32-95 legato, 96-127 slide",
      "82": "Dirección de rasgueo: 0-31 abajo, 32-95 arriba, 96-127 alterno",
      "83": "Slide in/out permanente: 0 off, 42 slide-in, 85 slide-out abajo, 127 slide-out arriba",
      "pitchBend": "Bend de rueda (±2 ó ±12 st según bend_range)"
    },
    "comportamiento": {
      "legato": "Solo con modo legato/slide activo. Un solape de menos de 60 ms (25 ms en modo slide) se trata como acorde, no como ligadura. Sin modo activo las notas solapadas suenan independientes (arpegios).",
      "rasgueo": "Notas que llegan en el mismo instante con param strum > 0 se rasguean: graves primero en abajo, agudos primero en arriba; las cuerdas del lado donde empieza el golpe suenan más fuertes (strum_accent); ruido de púa.",
      "slideOut": "Empieza al soltar la nota (note-off): la afinación cae/sube slide_range semitonos en slide_time ms mientras la nota se apaga."
    }
  }
