    "intents": [
      "limpiar-ruido",
      "quitar-zumbido",
      "quitar-clics",
      "reparar-recorte",
      "quitar-reverb",
      "aislar-voz",
      "reparar-audio-automatico",
      "escuchar-lo-eliminado",
      "silenciar-entre-frases"
