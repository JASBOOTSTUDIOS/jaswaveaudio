{
  "id": "com.jaswave.plugin.audio-doctor",
  "name": "JasWave Audio Doctor",
  "version": "1.0.0",
  "category": "audio-effect",
  "vendor": "JasWave Audio",
  "description": "Restauración de audio universal: noise gate/expander con sidechain, denoise espectral (perfil aprendido o continuo), de-hum 50/60 Hz con seguimiento y armónicos, de-click, de-clip, de-reverb, aislador de voz, recuperación de aire, Auto-Fix por diagnóstico, escucha del delta (lo eliminado) y modo Live Mic de latencia mínima.",
  "targetPlatforms": [
    "win-x64"
  ],
  "entrypoints": {
    "dspDesktop": "bin/JasWaveAudioDoctor.vst3"
  },
  "vst3": {
    "classId": "{4A617357-4144-4F43-5072-6F6356335431}",
    "subCategories": "Fx|Restoration"
  },
  "permissions": {
    "realtimeAudio": true,
    "fileSystem": "none",
    "network": false,
    "commands": [
      "plugin.setParameter"
    ]
  },
  "rolesAllowed": [
    "productor",
    "mezcla",
    "mastering",
    "qa"
  ],
  "license": {
    "productId": "com.jaswave.plugin.audio-doctor",
    "features": []
  },
  "ai": {
