{
  "id": "com.jaswave.plugin.piano-synth",
  "name": "JasWave Piano Synth",
  "version": "1.0.0",
  "category": "instrument",
  "vendor": "JasWave Audio",
  "description": "Piano de síntesis modal (sin muestras): parciales inarmónicos, cuerdas al unísono, martillo, pedal de sustain y polifonía de hasta 64 voces.",
  "targetPlatforms": [
    "win-x64"
  ],
  "entrypoints": {
    "dspDesktop": "bin/JasWavePiano.vst3"
  },
  "vst3": {
    "classId": "{B3A7C9E1-4D2F-4A8B-9E6C-1F3D5A7B8C0D}",
    "subCategories": "Instrument|Piano"
  },
  "permissions": {
    "realtimeAudio": true,
    "fileSystem": "none",
    "network": false,
    "commands": [
      "plugin.setParameter"
    ]
  },
  "rolesAllowed": [
    "productor"
  ],
  "license": {
    "productId": "com.jaswave.plugin.piano-synth",
    "features": [
      {
        "key": "piano.polifonia-extendida",
        "description": "Polifonía de 64 voces (básica: 16)"
      },
      {
        "key": "piano.imagen-estereo",
        "description": "Imagen estéreo por registro"
      }
    ]
  },
  "ai": {
