{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@jaswave/host-sdk": ["../src/index.ts"],
      "@jaswave/host-sdk/*": ["../src/*"],
      "@/*": ["../../../../jas-wave/*"],
      "@jaswave/ai-harness": ["../../../../ai-harness/src/index.ts"],
      "@jaswave/shared": ["../../../../shared/src/index.ts"]
    }
  }
}
