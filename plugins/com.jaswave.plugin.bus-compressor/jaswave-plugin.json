{
  "id": "com.jaswave.plugin.bus-compressor",
  "name": "JasWave Bus Compressor",
  "version": "1.0.0",
  "category": "audio-effect",
  "vendor": "JasWave Audio",
  "description": "Compresor VCA feed-forward de bus con rodilla suave, detector Peak/RMS enlazado, filtro de sidechain y mezcla paralela.",
  "targetPlatforms": [
    "win-x64"
  ],
  "entrypoints": {
    "dspDesktop": "bin/JasWaveBusCompressor.vst3"
  },
  "vst3": {
    "classId": "{4A617357-434F-4D50-5072-6F6356335431}",
    "subCategories": "Fx|Dynamics"
  },
  "permissions": {
    "realtimeAudio": true,
    "fileSystem": "none",
    "network": false,
    "commands": [
      "plugin.setParameter"
    ]
  },
  "rolesAllowed": [
    "productor",
    "mezcla",
    "mastering"
  ],
  "license": {
    "productId": "com.jaswave.plugin.bus-compressor",
    "features": [
      {
        "key": "comp.filtro-sidechain",
        "description": "Filtro paso alto del sidechain"
      },
      {
        "key": "comp.mezcla-paralela",
        "description": "Compresión paralela (mezcla dry/wet)"
      }
    ]
  },
  "ai": {
    "summary": "Compresor de bus para cohesionar mezclas y controlar dinámica (umbral, ratio, rodilla, ataque, release).",
    "intents": [
      "pegar-mezcla",
      "controlar-picos",
      "compresion-paralela",
      "controlar-dinamica"
    ],
    "parameters": [
      {
