        "vstParamId": 0,
        "name": "Bypass",
        "min": 0,
        "max": 1,
        "default": 0,
        "unit": "",
        "scale": "toggle",
        "feature": null,
        "bypass": true
      },
      {
        "id": "comp.umbral",
        "vstParamId": 1,
        "name": "Umbral",
        "min": -60,
        "max": 0,
        "default": -20,
        "unit": "dB",
        "scale": "linear",
        "feature": null
      },
      {
        "id": "comp.ratio",
        "vstParamId": 2,
        "name": "Ratio",
        "min": 1,
        "max": 20,
