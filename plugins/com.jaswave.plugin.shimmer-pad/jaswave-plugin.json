{
  "id": "com.jaswave.plugin.shimmer-pad",
  "name": "JasWave Shimmer Pad",
  "version": "1.0.0",
  "category": "instrument",
  "vendor": "JasWave Audio",
  "description": "Pad ambiental de worship moderno: supersaw band-limited + wavetable suave (unísono 2–7 voces con deriva orgánica y sub-octava), filtro SVF estable de 20 Hz a 20 kHz con LFO lento, ensemble chorus y reverb FDN shimmer (pitch shifter granular +12/+7/+24 en el lazo, RT60 real de 0,5 a 20 s). Polifonía de 16 voces, sustain (CC64), rueda de modulación (CC1), aftertouch y pitch bend. Rack de mezcla comun integrado (ids FX · 100..230): paso-altos/bajos, ecualizador parametrico de 6 bandas, compresor, saturacion cinta/valvula, chorus, delay sincronizable al tempo, reverb plate/hall/room y anchura. Todo apagado por defecto (On = 0): no cambia el sonido hasta activarlo. Rack de mezcla comun integrado (ids FX · 100..230): paso-altos/bajos, ecualizador parametrico de 6 bandas, compresor, saturacion cinta/valvula, chorus, delay sincronizable al tempo, reverb plate/hall/room y anchura. Todo apagado por defecto (On = 0): no cambia el sonido hasta activarlo.",
  "targetPlatforms": [
    "win-x64",
    "web"
  ],
  "entrypoints": {
    "dspDesktop": "bin/JasWaveShimmerPad.vst3",
    "dspWeb": "web/shimmer-pad-worklet.js"
  },
  "vst3": {
    "classId": "{B3A7C9E6-4D2F-4A8B-9E6C-1F3D5A7B8C01}",
    "subCategories": "Instrument|Synth"
  },
  "permissions": {
    "realtimeAudio": true,
    "fileSystem": "none",
    "network": false,
    "commands": [
      "plugin.setParameter"
    ]
  },
  "rolesAllowed": [
    "productor"
  ],
  "license": {
    "productId": "com.jaswave.plugin.shimmer-pad",
    "features": [
