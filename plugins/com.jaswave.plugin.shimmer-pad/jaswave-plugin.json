{
  "id": "com.jaswave.plugin.shimmer-pad",
  "name": "JasWave Shimmer Pad",
  "version": "1.0.0",
  "category": "instrument",
  "vendor": "JasWave Audio",
  "description": "Sintetizador ambiental de texturas etéreas y pads worship. Síntesis sustractiva/wavetable dual con filtro resonante y motor de reverberación shimmer de octava superior infinita.",
  "targetPlatforms": [
    "win-x64",
    "web-wasm"
  ],
  "entrypoints": {
    "dspDesktop": "bin/JasWaveShimmerPad.vst3"
  },
  "vst3": {
    "classId": "{B3A7C9E6-4D2F-4A8B-9E6C-1F3D5A7B8C01}",
    "subCategories": "Instrument|Synth"
  },
  "permissions": {
    "realtimeAudio": true,
    "fileSystem": "none",
    "network": false,
    "commands": [
      "plugin.setParameter"
    ]
  },
  "rolesAllowed": [
    "productor"
  ],
  "license": {
    "productId": "com.jaswave.plugin.shimmer-pad",
    "features": [
      {
        "key": "pad.infinite-shimmer",
        "description": "Modo de cola infinita y pitch shifter de doble octava"
      }
    ]
  },
  "ai": {
    "summary": "Sintetizador de pads y atmósferas con control de corte de filtro, resonancia, brillo shimmer y modulación LFO.",
    "intents": [
      "pad-ambiente",
      "shimmer-worship",
      "atmosfera-espacial",
      "colchon-armonico"
    ],
    "parameters": [
      {
        "id": "cutoff",
        "vstParamId": 0,
        "name": "Corte de Filtro (Cutoff)",
        "min": 100,
        "max": 12000,
        "default": 2500,
        "unit": "Hz",
        "scale": "log",
        "feature": null
      },
      {
        "id": "resonance",
        "vstParamId": 1,
        "name": "Resonancia del Filtro (Q)",
        "min": 0,
        "max": 100,
        "default": 20,
        "unit": "%",
        "scale": "linear",
        "feature": null
      },
      {
        "id": "shimmer_octave",
        "vstParamId": 2,
        "name": "Brillo Shimmer (+12st)",
        "min": 0,
        "max": 100,
        "default": 40,
        "unit": "%",
        "scale": "linear",
        "feature": "pad.infinite-shimmer"
      },
      {
        "id": "shimmer_decay",
        "vstParamId": 3,
        "name": "Decaimiento Shimmer (Decay)",
        "min": 0.5,
        "max": 20.0,
        "default": 4.5,
        "unit": "s",
        "scale": "linear",
        "feature": null
      },
      {
        "id": "lfo_rate",
        "vstParamId": 4,
        "name": "Velocidad de LFO (Rate)",
        "min": 0.1,
        "max": 10.0,
        "default": 1.2,
        "unit": "Hz",
        "scale": "linear",
        "feature": null
      },
      {
        "id": "bypass",
        "vstParamId": 5,
        "name": "Bypass",
        "min": 0,
        "max": 1,
        "default": 0,
        "unit": "",
        "scale": "stepped",
        "feature": null
      },
      {
        "id": "volume",
        "vstParamId": 6,
        "name": "Volumen Principal",
        "min": -24,
        "max": 6,
        "default": 0,
        "unit": "dB",
        "scale": "linear",
        "feature": null
      }
    ]
  }
}
